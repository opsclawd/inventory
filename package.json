{
  "name": "inventory",
  "private": true,
  "version": "0.0.0",
  "packageManager": "pnpm@9.12.3",
  "engines": {
    "node": ">=22.0.0 <23.0.0"
  },
  "scripts": {
    "typecheck": "tsc --noEmit",
    "test": "vitest run",
    "test:db:rls": "VITEST_INCLUDE_RLS=1 vitest run src/infrastructure/db/__tests__/rls.integration.test.ts",
    "db:generate": "prisma generate",
    "db:migrate": "prisma migrate deploy",
    "db:seed": "tsx prisma/seed.ts",
    "verify:no-stubs": "node scripts/verify-no-stubs.mjs"
  },
  "prisma": {
    "seed": "tsx prisma/seed.ts"
  },
  "dependencies": {
    "@aws-sdk/client-s3": "^3.1169.0",
    "@aws-sdk/s3-request-presigner": "^3.1169.0",
    "@prisma/client": "6.19.3",
    "@supabase/ssr": "^0.12.7",
    "@supabase/supabase-js": "^2.114.0",
    "@zxing/browser": "^0.2.1",
    "next": "^15.5.0",
    "qrcode": "^1.5.4",
    "react": "^19.0.0",
    "react-dom": "^19.0.0",
    "sharp": "^0.35.5",
    "zod": "^3.24.2"
  },
  "devDependencies": {
    "@napi-rs/canvas": "^1.1.1",
    "@testing-library/react": "^16.3.3",
    "@testing-library/user-event": "^14.6.12",
    "@types/node": "^22.13.0",
    "@types/qrcode": "^1.5.6",
    "@types/react": "^19.0.0",
    "@types/react-dom": "^19.0.0",
    "@zxing/library": "^0.23.0",
    "jsdom": "^31.0.1",
    "pdfjs-dist": "^6.5.438",
    "prisma": "6.19.3",
    "tsx": "4.23.15",
    "typescript": "^5.8.0",
    "vitest": "^3.2.4"
  }
}
